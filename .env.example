SECRET_KEY=troque-por-uma-chave-longa

# --- Faturamento TOTVS (aba BI COMERCIAL) ---
# Credenciais da API TOTVS Moda. NUNCA suba o .env para o GitHub.
TOTVS_BASE_URL=https://www30.bhan.com.br:9443
TOTVS_GRANT_TYPE=password
TOTVS_CLIENT_ID=
TOTVS_CLIENT_SECRET=
TOTVS_USERNAME=
TOTVS_PASSWORD=
# opcionais
# TOTVS_BRANCHES=auto            (ou 1,2,3)
# FATURAMENTO_INICIO=2026-01-01
# RELATORIO150_OPERACOES=financeiro
# BI_INTERVALO_MIN=2            (atualizacao automatica a cada N minutos, com o servidor ligado)
# BI_HISTORICO_DESDE=2022-01       (a partir de que mes carregar o historico; padrao = janeiro do ano passado)
# PEDIDOS_INTERVALO_MIN=2        (Relatorio Pedidos: atualiza a aba pela API a cada N minutos)
# PEDIDOS_DIAS=180               (considera pedidos feitos nos ultimos N dias)
# PEDIDOS_CICLO=13               (ciclo das ordens de producao ligadas aos pedidos)
# MOVIMENTOS_INTERVALO_SEG=10     (pesagens da malharia: busca no TOTVS a cada N segundos)

# Envio do Relatorio de Faturamento por e-mail (botao "Enviar por e-mail" no BI, so Christian e Edmar)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587                  (587 = STARTTLS, 465 = SSL)
# SMTP_USER=seu.email@conexaomalhas.com.br
# SMTP_PASSWORD=senha-ou-senha-de-aplicativo
# SMTP_FROM=                     (opcional; padrao = SMTP_USER)
# RELATORIO_FAT_USUARIOS=christian,edmar,luciano   (quem ve os botoes do relatorio)

# Envio AUTOMATICO diario do Relatorio de Faturamento (PDF) por e-mail
# RELATORIO_FAT_ENVIO=1                          (0 desliga)
# RELATORIO_FAT_ENVIO_HORA=08:30
# RELATORIO_FAT_ENVIO_DIAS=0,1,2,3,4,5,6         (0 = segunda ... 6 = domingo; ex.: 0,1,2,3,4 = seg a sex)
# RELATORIO_FAT_ENVIO_FORMATO=pdf                (pdf, pptx ou ambos)
# RELATORIO_FAT_DESTINOS=edmar.santos@conexaomalhas.com.br,christian.yarzon@conexaomalhas.com.br

# PDF do Relatorio de Faturamento = copia exata da tela do Slide mensal (precisa do Chromium: python -m playwright install chromium)
# APP_URL=http://127.0.0.1:5000        # endereco do proprio Gestao (so mude se usar outra porta/endereco)
# RELATORIO_FAT_CAPTURA=1              # 0 = volta ao PDF padrao gerado por codigo

SECRET_KEY=troque-por-uma-chave-longa

# --- Faturamento TOTVS (aba BI COMERCIAL) ---
# Credenciais da API TOTVS Moda. NUNCA suba o .env para o GitHub.
TOTVS_BASE_URL=https://www30.bhan.com.br:9443
TOTVS_GRANT_TYPE=password
TOTVS_CLIENT_ID=
TOTVS_CLIENT_SECRET=
TOTVS_USERNAME=
TOTVS_PASSWORD=
# opcionais
# TOTVS_BRANCHES=auto            (ou 1,2,3)
# FATURAMENTO_INICIO=2026-01-01
# RELATORIO150_OPERACOES=financeiro
# BI_INTERVALO_MIN=2            (atualizacao automatica a cada N minutos, com o servidor ligado)
# BI_HISTORICO_DESDE=2022-01       (a partir de que mes carregar o historico; padrao = janeiro do ano passado)
# PEDIDOS_INTERVALO_MIN=2        (Relatorio Pedidos: atualiza a aba pela API a cada N minutos)
# PEDIDOS_DIAS=180               (considera pedidos feitos nos ultimos N dias)
# PEDIDOS_CICLO=13               (ciclo das ordens de producao ligadas aos pedidos)
# MOVIMENTOS_INTERVALO_SEG=10     (pesagens da malharia: busca no TOTVS a cada N segundos)

# Envio do Relatorio de Faturamento por e-mail (botao "Enviar por e-mail" no BI, so Christian e Edmar)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587                  (587 = STARTTLS, 465 = SSL)
# SMTP_USER=seu.email@conexaomalhas.com.br
# SMTP_PASSWORD=senha-ou-senha-de-aplicativo
# SMTP_FROM=                     (opcional; padrao = SMTP_USER)
# RELATORIO_FAT_USUARIOS=christian,edmar,luciano   (quem ve os botoes do relatorio)

# Envio AUTOMATICO diario do Relatorio de Faturamento (PDF) por e-mail
# RELATORIO_FAT_ENVIO=1                          (0 desliga)
# RELATORIO_FAT_ENVIO_HORA=08:00,13:00           (horarios de Brasilia; um e-mail em cada)
# RELATORIO_FAT_ENVIO_JANELA_H=4                 (se o Gestao so ligar mais de 4 h depois do horario, pula aquele envio)
# RELATORIO_FAT_ENVIO_DIAS=0,1,2,3,4            (0 = segunda ... 6 = domingo; padrao: seg a sex)
# RELATORIO_FAT_ENVIO_FORMATO=pdf                (pdf, pptx ou ambos)
# RELATORIO_FAT_ENVIO_PEDIDOS=1                  (1 = manda junto o PDF da Entrada de Pedidos, em alta prioridade; 0 = so o faturamento)
# RELATORIO_FAT_DESTINOS=a@conexaomalhas.com.br,b@conexaomalhas.com.br   (padrao: a lista fixa no codigo)

# PDF do Relatorio de Faturamento = copia exata da tela do Slide mensal (precisa do Chromium: python -m playwright install chromium)
# APP_URL=http://127.0.0.1:5000        # endereco do proprio Gestao (so mude se usar outra porta/endereco)

# Banco em outra pasta (ex.: Gestao em pasta de rede, banco no disco local). Em pasta de rede o modo WAL e desligado automaticamente.
# GESTAO_DB=C:\GestaoConexaoDados\gestao_conexao.db
# GESTAO_SQLITE_WAL=0                  (1 = padrao; 0 desliga o WAL)

# Programacao ao vivo a partir do PCP Hub (le a tabela machine_production; so leitura). Use um usuario do PCP Hub com acesso a regiao BR.
# PCPHUB_EMAIL=usuario@conexaomalhas.com.br
# PCPHUB_PASSWORD=senha
# PCPHUB_INTERVALO_MIN=5                (atualiza a cada N minutos)

# Indicadores (aba Producao): pecas do acabamento pela API do TOTVS (transacoes 2030/2031)
# INDICADORES_DESDE=2026-09-01                   (a partir de quando buscar na 1a vez)
# INDICADORES_INTERVALO_MIN=2                    (a cada quantos minutos atualiza; padrao 2)

# Reprova Cru (local 24): lista de NCs "ncform" do SharePoint, lida pela API Graph (so leitura)
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=                            (padrao: conexaomalhasedes)
# SHAREPOINT_LISTA_NC=ncform

# Setups (acompanhamento de producao): numero de setups do dia na Reuniao Diaria
# SETUPS_URL=http://108.165.179.201:8090/api/v1
# SETUPS_TOKEN=                                  (a API responde 401 sem o token)

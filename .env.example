SECRET_KEY=troque-por-uma-chave-longa

# --- Faturamento TOTVS (aba BI COMERCIAL) ---
# Credenciais da API TOTVS Moda. NUNCA suba o .env para o GitHub.
TOTVS_BASE_URL=https://www30.bhan.com.br:9443
TOTVS_GRANT_TYPE=password
TOTVS_CLIENT_ID=
TOTVS_CLIENT_SECRET=
TOTVS_USERNAME=
TOTVS_PASSWORD=
# opcionais
# TOTVS_BRANCHES=auto            (ou 1,2,3)
# FATURAMENTO_INICIO=2026-01-01
# RELATORIO150_OPERACOES=financeiro
# BI_INTERVALO_MIN=2            (atualizacao automatica a cada N minutos, com o servidor ligado)
# BI_HISTORICO_DESDE=2022-01       (a partir de que mes carregar o historico; padrao = janeiro do ano passado)
# PEDIDOS_INTERVALO_MIN=2        (Relatorio Pedidos: atualiza a aba pela API a cada N minutos)
# PEDIDOS_DIAS=180               (considera pedidos feitos nos ultimos N dias)
# PEDIDOS_CICLO=13               (ciclo das ordens de producao ligadas aos pedidos)
# MOVIMENTOS_INTERVALO_SEG=10     (pesagens da malharia: busca no TOTVS a cada N segundos)
